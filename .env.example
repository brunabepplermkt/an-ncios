# --- Database (Supabase Postgres) ---
# No Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL = "Connection pooling" (porta 6543, Transaction mode) — usada
#   em runtime. Necessária pra serverless (Vercel), evita esgotar conexões.
# DIRECT_URL   = "Direct connection" (porta 5432) — usada só por
#   `prisma db push`/`migrate`, que precisam de uma conexão direta (sem pooler).
# As duas vêm do mesmo projeto Supabase, só trocam a porta/host.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[SUA-SENHA]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[SUA-SENHA]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# --- Meta Ads (READ ONLY) ---
# Fill in tomorrow. See docs/META_SETUP.md
META_ADS_ACCESS_TOKEN=
# Optional: only needed if you want to skip the "Testar conexão -> selecionar
# conta" step in /integrations. Format: act_XXXXXXXXX. If left empty, select
# the account in the UI instead — it gets stored in the app database, not here.
META_AD_ACCOUNT_ID=

# --- Google Ads (READ ONLY) ---
# Fill in tomorrow. See docs/GOOGLE_SETUP.md
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Optional: same idea as META_AD_ACCOUNT_ID above — can be selected in the UI instead.
GOOGLE_ADS_CUSTOMER_ID=
# Only needed if you access the account through an MCC (agency) account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional override. NEVER hardcode this elsewhere — Google Ads API major
# versions sunset yearly. Default in code is v25 (verified 2026-09-18);
# check developers.google.com/google-ads/api/docs/release-notes and set
# this if a newer version is current by the time you connect for real.
GOOGLE_ADS_API_VERSION=

# --- AI Provider (mock by default; safe to leave empty) ---
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
